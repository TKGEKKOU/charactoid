{
  "name": "charactoid-web",
  "version": "0.0.1-rc.3",
  "description": "CHARACTOID one-command local runtime and web launcher",
  "bin": {
    "charactoid-web": "bin/charactoid.mjs"
  },
  "files": [
    "bin/charactoid.mjs",
    "package-runtime"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TKGEKKOU/charactoid.git"
  },
  "homepage": "https://github.com/TKGEKKOU/charactoid",
  "license": "MIT",
  "scripts": {
    "build:npm": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-npm-runtime.ps1",
    "pack:npm": "npm run build:npm && npm pack --dry-run",
    "release:npm": "npm run build:npm && npm publish",
    "release:npm:patch": "npm version patch --no-git-tag-version && npm run release:npm"
  }
}
